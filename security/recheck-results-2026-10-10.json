  "findings": [
    {
      "id": "F01",
      "priority": "High priority hardening",
      "title": "Administrator MFA is not enrolled or enforced",
      "evidence": "The sole owner has zero verified MFA factors. The current administrator client, Edge handler, and inspected public RLS policies do not enforce aal2.",
      "impact": "A compromised administrator password can grant publishing access; a compromised owner password can also grant administrator-management access.",
      "next_step": "Implement the enrollment and challenge flows, enroll the owner, and enforce MFA for privileged access in both RLS and the Edge handler. Do not enforce aal2 before a working enrollment/recovery path exists.",
      "reference": "https://supabase.com/docs/guides/auth/auth-mfa"
    },
    {
      "id": "F02",
      "priority": "Recommended",
      "title": "Leaked-password protection is disabled",
      "evidence": "Supabase Security Advisor returned auth_leaked_password_protection at WARN level.",
      "impact": "The account system does not currently reject passwords on the compromised-password list using this feature.",
      "next_step": "Enable leaked-password protection if supported by the project plan and choose a strong, unique administrator password.",
      "reference": "https://supabase.com/docs/guides/auth/password-security#password-strength-and-leaked-password-protection"
    },
    {
      "id": "F03",
      "priority": "Recommended",
      "title": "Public account signup remains enabled",
      "evidence": "The live Auth settings endpoint reports disable_signup=false; the church website has no public registration feature.",
      "impact": "Unnecessary accounts can be registered through Auth. The tested allowlist and RLS still deny non-administrators CMS access.",
      "next_step": "Disable new public signups while preserving the owner invitation flow."
    },
    {
      "id": "F04",
      "priority": "Recommended",
      "title": "Administrator page lacks a framing restriction",
      "evidence": "The live /admin/ response has neither X-Frame-Options nor an HTTP Content-Security-Policy frame-ancestors directive.",
      "impact": "The response does not supply a standard header-based defense against another site framing the administrator interface. Browser exploitation was not attempted.",
      "next_step": "Configure an appropriate frame-ancestors policy at a hosting or proxy layer that supports response headers; a meta CSP cannot enforce this directive."
    },
    {
      "id": "F05",
      "priority": "Defense in depth",
      "title": "Strict-Transport-Security header is absent",
      "evidence": "The live /admin/ response has no Strict-Transport-Security header. HTTP-to-HTTPS redirect testing passed.",
      "impact": "The response itself does not instruct browsers to require HTTPS on future visits through HSTS.",
      "next_step": "Configure HSTS through a suitable host/proxy after validating HTTPS coverage. Do not blindly enable includeSubDomains or preload."
    },
    {
      "id": "F06",
      "priority": "Defense in depth",
      "title": "X-Content-Type-Options header is absent",
      "evidence": "The live /admin/ response has no X-Content-Type-Options header. The Edge handler sets nosniff in its tested responses.",
      "impact": "Static-page responses lack this additional MIME-sniffing defense.",
      "next_step": "Set X-Content-Type-Options: nosniff through a host/proxy with response-header support."
    }
  ],
